---
const stack = ['Go', 'Vue', 'C# / .NET', 'Angular', 'Flutter', 'Rust'];
---

<section id="top" class="hero section">
  <div class="container hero-wrap">
    <p class="hi">Hi, I am</p>

    <h1 class="title">
      <span class="name name-float">Yanosh</span>
    </h1>

    <p class="tagline">Software Engineer.</p>

    <p class="lead">
      I build across the stack — web, mobile, and the services behind them.
      Working full-time, shipping my own projects on the side. Based in Kyiv.
    </p>

    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">
        View work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <ul class="stack" aria-label="Tech stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  .hi {
    font-size: 0.95rem;
    color: var(--text-mute);
    margin: 0 0 0.85rem;
    letter-spacing: 0.04em;
  }

  .title {
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .name {
    display: inline-block;
    background: var(--name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Gentle "suspended in water" drift — a slow bob, slight sway and micro-tilt.
     Static blue-to-green ocean gradient underneath; no glitch. */
  .name-float {
    animation: name-float 12s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes name-float {
    0%, 100% { transform: translate(0, 0)        rotate(0deg);     }
    33%      { transform: translate(1px, -3px)   rotate(-0.25deg); }
    66%      { transform: translate(-1px, -2px)  rotate(0.25deg);  }
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 580px;
    margin: 0 0 2rem;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--accent);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stack li {
    font-size: 0.78rem;
    color: var(--text-dim);
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease,
                background 0.2s ease, transform 0.2s ease;
  }
  .stack li:hover {
    color: var(--text);
    border-color: var(--accent-soft);
    background: var(--surface-hover);
    transform: translateY(-2px);
  }
  /* Backend = primary focus: accent-tinted and a touch stronger.
     Web / mobile = secondary: muted, lighter weight. */

  @media (prefers-reduced-motion: reduce) {
    .name-float { animation: none; }
  }
</style>
