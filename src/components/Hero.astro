---
const stack = ['Vue', 'Go', 'Rust', 'TypeScript', 'C# / .NET'];
---

<section id="top" class="hero section">
  <div class="container hero-wrap">
    <p class="hi">Hi, I am</p>

    <h1 class="title">
      <span class="name-swap" aria-label="Yanosh, also known as Janos">
        <span class="name name-a">Yanosh</span>
        <span class="name name-b" aria-hidden="true">Janos</span>
      </span>
    </h1>

    <p class="tagline">Backend-oriented full-stack developer.</p>

    <p class="lead">
      Currently building with <strong>Vue</strong> and <strong>Go</strong>,
      learning <strong>Rust</strong>. Also work with <strong>TypeScript / Node</strong>
      and <strong>C# / .NET</strong>. Based in Kyiv.
    </p>

    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">
        View work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <ul class="stack" aria-label="Tech stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  .hi {
    font-size: 0.95rem;
    color: var(--text-mute);
    margin: 0 0 0.85rem;
    letter-spacing: 0.04em;
  }

  .title {
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .name-swap {
    position: relative;
    display: inline-block;
    min-width: 5.5ch;
  }
  .name-swap .name {
    display: inline-block;
    background: var(--name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .name-swap .name-b {
    position: absolute;
    left: 0; top: 0;
    white-space: nowrap;
  }
  .name-a { animation: name-a 8s infinite cubic-bezier(0.65, 0, 0.35, 1); }
  .name-b { animation: name-b 8s infinite cubic-bezier(0.65, 0, 0.35, 1); }
  @keyframes name-a {
    0%, 45%   { opacity: 1; transform: translateY(0); filter: blur(0); }
    50%, 95%  { opacity: 0; transform: translateY(-10px); filter: blur(6px); }
    100%      { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  @keyframes name-b {
    0%, 45%   { opacity: 0; transform: translateY(10px); filter: blur(6px); }
    50%, 95%  { opacity: 1; transform: translateY(0); filter: blur(0); }
    100%      { opacity: 0; transform: translateY(10px); filter: blur(6px); }
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 580px;
    margin: 0 0 2rem;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--accent);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stack li {
    font-size: 0.78rem;
    color: var(--text-dim);
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  @media (prefers-reduced-motion: reduce) {
    .name-a, .name-b { animation: none; }
    .name-b { display: none; }
  }
</style>
