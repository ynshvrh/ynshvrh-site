---
---

<section id="top" class="hero section">
  <div class="container hero-wrap">
    <a href="#contact" class="open-badge">
      <span class="open-dot" aria-hidden="true"></span>
      Open to work
    </a>

    <p class="hi">Hi, I am</p>

    <h1 class="title">
      <span class="name name-float">Yanosh</span>
    </h1>

    <p class="tagline">Backend & Software Engineer</p>

    <p class="lead">
      Specializing in <strong>C# (.NET)</strong> and <strong>Go (Golang)</strong> backend architecture. 
      Building scalable APIs, microservices, and reliable database systems — with production experience pairing 
      frontends in Angular and Vue.js. Based in Kyiv, open to work.
    </p>

    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">
        View work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <div class="stack-grid" aria-label="Core Tech Stacks">
      <div class="stack-card glowing-card">
        <div class="card-header-row">
          <h3 class="stack-title">Core Backend Stack</h3>
          <div class="tech-icons">
            <!-- C# icon -->
            <svg class="tech-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="C#">
              <path d="M16 18c-3.866 0-7-3.134-7-7s3.134-7 7-7" />
              <path d="M12 9h8M12 13h8M14 7v8M18 7v8" />
            </svg>
          </div>
        </div>
        <p class="stack-pair">C# (.NET 10)</p>
        <p class="stack-desc">Enterprise backend architecture, Minimal APIs, EF Core, JWT auth & clean domain design. (Paired with Angular on frontend)</p>
      </div>

      <div class="stack-card glowing-card">
        <div class="card-header-row">
          <h3 class="stack-title">Core Backend Stack</h3>
          <div class="tech-icons">
            <!-- Go icon -->
            <svg class="tech-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="Go">
              <path d="M18 11h-6v2h4.5A5.5 5.5 0 1 1 12 6.5" />
              <path d="M2 9h3M2 13h2M2 17h4" />
            </svg>
          </div>
        </div>
        <p class="stack-pair">Go (Golang)</p>
        <p class="stack-desc">High-performance microservices, concurrency, lightweight REST APIs & GORM. (Paired with Vue 3 on frontend)</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .hero-wrap {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  /* Availability badge */
  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    margin: 0 auto 1.4rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-soft);
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    box-shadow: 0 0 16px -4px rgba(239, 68, 68, 0.3);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .open-badge:hover {
    color: var(--accent-soft);
    background: rgba(239, 68, 68, 0.22);
    box-shadow: 0 0 20px -2px rgba(239, 68, 68, 0.5);
    transform: translateY(-1px);
  }
  .open-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent-soft);
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
    animation: open-pulse 2s infinite;
  }
  @keyframes open-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(239, 68, 68, 0.6); }
    70%  { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);   }
    100% { box-shadow: 0 0 0 0   rgba(239, 68, 68, 0);   }
  }

  .hi {
    font-size: 0.95rem;
    color: var(--text-mute);
    margin: 0 0 0.85rem;
    letter-spacing: 0.04em;
  }

  .title {
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .name {
    display: inline-block;
    background: var(--name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .name-float {
    animation: name-float 12s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes name-float {
    0%, 100% { transform: translate(0, 0)        rotate(0deg);     }
    33%      { transform: translate(1px, -3px)   rotate(-0.25deg); }
    66%      { transform: translate(-1px, -2px)  rotate(0.25deg);  }
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 620px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--accent);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  /* Core Stacks Cards Grid */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .stack-card {
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
    text-align: left;
  }
  .stack-card:hover {
    transform: translateY(-2px);
  }
  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .tech-icons {
    display: flex;
    gap: 0.6rem;
    color: var(--text-mute);
  }
  .tech-icon {
    opacity: 0.7;
    color: var(--accent);
    transition: color 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }
  .stack-card:hover .tech-icon {
    color: var(--accent-soft);
    opacity: 1;
    transform: scale(1.1);
  }
  .stack-title {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .stack-pair {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .stack-desc {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 600px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-float { animation: none; }
    .open-dot { animation: none; }
  }
</style>
