---
---

<section id="top" class="hero section">
  <div class="container hero-wrap">
    <a href="#contact" class="open-badge">
      <span class="open-dot" aria-hidden="true"></span>
      Open to work · Remote / Kyiv
    </a>

    <p class="hi">Hi, I'm</p>

    <h1 class="title">
      <span class="name name-float">Yanosh</span>
    </h1>

    <p class="tagline">
      Software Engineer focused on <span class="highlight-go">Go</span>, with a solid background in <span class="highlight-cs">C#</span>
    </p>

    <p class="lead">
      Building backend services that actually ship — scalable REST APIs, payment & subscription-style architecture, 
      and high-concurrency systems, along with modern full-stack web clients in Vue.js and Angular.
    </p>

    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">
        View work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <div class="stack-grid" aria-label="Core Tech Stacks">
      <div class="stack-card glowing-card">
        <div class="card-header-row">
          <span class="stack-category tag-terminal">Primary Backend Focus</span>
          <div class="tech-icons">
            <!-- Go icon -->
            <svg class="tech-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="Go">
              <path d="M18 11h-6v2h4.5A5.5 5.5 0 1 1 12 6.5" />
              <path d="M2 9h3M2 13h2M2 17h4" />
            </svg>
          </div>
        </div>
        <h3 class="stack-pair">Go (Golang)</h3>
        <p class="stack-desc">High-performance microservices, concurrency patterns, lightweight REST APIs, Gin & GORM. (Paired with Vue 3 / TypeScript on frontend)</p>
      </div>

      <div class="stack-card glowing-card">
        <div class="card-header-row">
          <span class="stack-category tag-terminal">Solid Background</span>
          <div class="tech-icons">
            <!-- C# icon -->
            <svg class="tech-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="C#">
              <path d="M16 18c-3.866 0-7-3.134-7-7s3.134-7 7-7" />
              <path d="M12 9h8M12 13h8M14 7v8M18 7v8" />
            </svg>
          </div>
        </div>
        <h3 class="stack-pair">C# (.NET 10)</h3>
        <p class="stack-desc">Enterprise backend architecture, Minimal APIs, EF Core, SignalR real-time messaging, JWT auth & clean domain design. (Paired with Angular)</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
  }

  .hero-wrap {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  /* Availability badge */
  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    margin: 0 auto 1.5rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-family: var(--mono);
    font-weight: 500;
    color: var(--accent-secondary-soft);
    background: var(--amber-tint);
    border: 1px solid rgba(245, 158, 11, 0.35);
    box-shadow: 0 0 16px -4px rgba(245, 158, 11, 0.3);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .open-badge:hover {
    color: var(--accent-secondary-soft);
    background: var(--amber-tint-strong);
    box-shadow: 0 0 20px -2px rgba(245, 158, 11, 0.5);
    transform: translateY(-1px);
  }
  .open-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent-secondary);
    box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
    animation: open-pulse 2s infinite;
  }
  @keyframes open-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0.7); }
    70%  { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0);   }
    100% { box-shadow: 0 0 0 0   rgba(245, 158, 11, 0);   }
  }

  .hi {
    font-size: 1rem;
    color: var(--text-mute);
    margin: 0 0 0.75rem;
    letter-spacing: 0.05em;
    font-family: var(--mono);
  }

  .title {
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    line-height: 1;
    margin: 0 0 1.1rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .name {
    display: inline-block;
    background: var(--name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .name-float {
    animation: name-float 10s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes name-float {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translateY(-4px); }
  }

  .tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    color: var(--text);
    margin: 0 0 1.4rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .highlight-go {
    color: var(--accent-soft);
    font-weight: 700;
  }
  .highlight-cs {
    color: var(--accent-secondary-soft);
    font-weight: 700;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 640px;
    margin: 0 auto 2.25rem;
    line-height: 1.7;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 3.25rem;
  }

  /* Core Stacks Cards Grid */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .stack-card {
    border-radius: 16px;
    padding: 1.35rem 1.6rem;
    box-shadow: var(--card-shadow);
    text-align: left;
  }
  .stack-card:hover {
    transform: translateY(-2px);
  }
  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .tech-icons {
    display: flex;
    gap: 0.6rem;
  }
  .tech-icon {
    color: var(--accent-soft);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .stack-card:hover .tech-icon {
    color: var(--accent-secondary-soft);
    transform: scale(1.12);
  }
  .stack-category {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stack-pair {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .stack-desc {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 640px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-float { animation: none; }
    .open-dot { animation: none; }
  }
</style>
