---
---

<section id="top" class="hero section">
  <div class="container hero-wrap">
    <a href="#contact" class="open-badge">
      <span class="open-dot" aria-hidden="true"></span>
      Open to work
    </a>

    <p class="hi">Hi, I am</p>

    <h1 class="title">
      <span class="name name-float">Yanosh</span>
    </h1>

    <p class="tagline">Software Engineer.</p>

    <p class="lead">
      I am a software engineer focused on building robust backends and clean frontends. 
      I specialize in two production-ready developer stacks, selecting the right toolset 
      for the project's scale. Based in Kyiv, open to work.
    </p>

    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">
        View work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <div class="stack-grid" aria-label="Core Tech Stacks">
      <div class="stack-card">
        <h3 class="stack-title">Enterprise & Robust</h3>
        <p class="stack-pair">C# + Angular</p>
        <p class="stack-desc">Solid, scalable architecture, type safety, and maintainable enterprise web platforms.</p>
      </div>
      <div class="stack-card">
        <h3 class="stack-title">Agile & Lightweight</h3>
        <p class="stack-pair">Go + Vue</p>
        <p class="stack-desc">Fast backend services, high concurrency, and clean, reactive client-side applications.</p>
      </div>
    </div>

    <div class="fun-stack">
      <span class="fun-label">For fun & side projects:</span>
      <ul class="fun-list">
        <li>Rust</li>
        <li>Dart (Flutter)</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  /* Availability badge — a green "open to work" pill with a pulsing dot,
     links down to the contact section. */
  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    margin-bottom: 1.4rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #46d39a;
    background: rgba(70, 211, 154, 0.10);
    border: 1px solid rgba(70, 211, 154, 0.30);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .open-badge:hover {
    color: #46d39a;
    background: rgba(70, 211, 154, 0.18);
    transform: translateY(-1px);
  }
  .open-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #46d39a;
    box-shadow: 0 0 0 0 rgba(70, 211, 154, 0.5);
    animation: open-pulse 2s infinite;
  }
  @keyframes open-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(70, 211, 154, 0.5); }
    70%  { box-shadow: 0 0 0 8px rgba(70, 211, 154, 0);   }
    100% { box-shadow: 0 0 0 0   rgba(70, 211, 154, 0);   }
  }

  .hi {
    font-size: 0.95rem;
    color: var(--text-mute);
    margin: 0 0 0.85rem;
    letter-spacing: 0.04em;
  }

  .title {
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .name {
    display: inline-block;
    background: var(--name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Gentle "suspended in water" drift — a slow bob, slight sway and micro-tilt.
     Static blue-to-green ocean gradient underneath; no glitch. */
  .name-float {
    animation: name-float 12s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes name-float {
    0%, 100% { transform: translate(0, 0)        rotate(0deg);     }
    33%      { transform: translate(1px, -3px)   rotate(-0.25deg); }
    66%      { transform: translate(-1px, -2px)  rotate(0.25deg);  }
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-dim);
    max-width: 580px;
    margin: 0 0 2rem;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--accent);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  /* Core Stacks Cards Grid */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .stack-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    text-align: left;
  }
  .stack-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-soft);
    box-shadow: var(--card-shadow-hover);
  }
  .stack-title {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.4rem;
  }
  .stack-pair {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .stack-desc {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0;
  }

  /* Fun Stack list */
  .fun-stack {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .fun-label {
    font-size: 0.82rem;
    color: var(--text-mute);
    font-weight: 500;
  }
  .fun-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fun-list li {
    font-size: 0.75rem;
    color: var(--text-dim);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .fun-list li:hover {
    color: var(--text);
    border-color: var(--accent-soft);
    background: var(--surface-hover);
  }

  @media (max-width: 600px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-float { animation: none; }
    .open-dot { animation: none; }
  }
</style>
