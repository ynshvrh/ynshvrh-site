---
// Ambient illustrations that swap with the theme:
//   light → cute frog on a lily pad, bottom-right
//   dark  → distant orca silhouette drifting across the deep
// Both live in a fixed pointer-events:none layer so they never push
// layout around. SVGs use gradients + bezier paths for an illustrated,
// rather than geometric, look.
---

<div class="ambient" aria-hidden="true">
  <!-- ─────────── LIGHT THEME · Lily Pond friend ─────────── -->
  <svg
    class="art-frog"
    viewBox="0 0 240 180"
    width="220"
    height="165"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="frogPad" cx="50%" cy="32%" r="70%">
        <stop offset="0%"   stop-color="#b6dba5" />
        <stop offset="55%"  stop-color="#7fbb6c" />
        <stop offset="100%" stop-color="#5e9b4d" />
      </radialGradient>
      <linearGradient id="frogBody" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%"   stop-color="#a8d692" />
        <stop offset="55%"  stop-color="#7fb56e" />
        <stop offset="100%" stop-color="#5e9b4d" />
      </linearGradient>
      <radialGradient id="frogBelly" cx="50%" cy="35%" r="80%">
        <stop offset="0%"   stop-color="#fafce6" />
        <stop offset="100%" stop-color="#dbeac1" />
      </radialGradient>
      <radialGradient id="frogEye" cx="50%" cy="35%" r="65%">
        <stop offset="0%"   stop-color="#a8d692" />
        <stop offset="100%" stop-color="#7fb56e" />
      </radialGradient>
      <radialGradient id="lotusPetal" cx="50%" cy="35%" r="70%">
        <stop offset="0%"   stop-color="#fde2ea" />
        <stop offset="100%" stop-color="#ef9bb0" />
      </radialGradient>
    </defs>

    <!-- Water reflection lines below the pad -->
    <ellipse cx="120" cy="162" rx="105" ry="3.5" fill="rgba(29, 58, 74, 0.10)" />
    <ellipse cx="120" cy="168" rx="62"  ry="2"   fill="rgba(29, 58, 74, 0.06)" />

    <!-- Background lily pad (small, to the left) -->
    <ellipse cx="40"  cy="150" rx="28" ry="6" fill="#5e9b4d" opacity="0.42" />

    <!-- Main lily pad with notch + veins -->
    <ellipse cx="120" cy="145" rx="100" ry="22" fill="url(#frogPad)" />
    <path d="M120 122 L138 145 L120 168 Z" fill="#cee5f0" />
    <g stroke="rgba(29, 58, 74, 0.10)" stroke-width="0.8" fill="none" stroke-linecap="round">
      <path d="M120 145 Q90 138 36 132" />
      <path d="M120 145 Q90 153 38 162" />
      <path d="M120 145 Q160 138 210 132" />
      <path d="M120 145 Q160 153 210 162" />
    </g>

    <!-- Lotus flower (top right of pad) -->
    <g transform="translate(195, 130)">
      <ellipse cx="0" cy="6" rx="16" ry="5" fill="#5e9b4d" opacity="0.5" />
      <ellipse cx="-7" cy="-2" rx="5" ry="9" fill="url(#lotusPetal)" transform="rotate(-22)" />
      <ellipse cx="7"  cy="-2" rx="5" ry="9" fill="url(#lotusPetal)" transform="rotate(22)" />
      <ellipse cx="0"  cy="-4" rx="4" ry="9" fill="#fde2ea" />
      <circle  cx="0"  cy="-2" r="1.8" fill="#f4d35e" />
    </g>

    <!-- Frog body shadow -->
    <ellipse cx="100" cy="128" rx="44" ry="8" fill="rgba(29, 58, 74, 0.12)" />

    <!-- Frog body (rounded, slightly squat) -->
    <path d="M58 102
             C58 78, 78 70, 100 70
             C122 70, 142 78, 142 102
             C142 128, 122 134, 100 134
             C78 134, 58 128, 58 102 Z"
          fill="url(#frogBody)" />

    <!-- Belly -->
    <path d="M76 112
             C76 102, 88 96, 100 96
             C112 96, 124 102, 124 112
             C124 124, 112 128, 100 128
             C88 128, 76 124, 76 112 Z"
          fill="url(#frogBelly)" />
    <!-- Belly soft highlight -->
    <ellipse cx="93" cy="108" rx="13" ry="3" fill="rgba(255,255,255,0.55)" />

    <!-- Front legs poking out -->
    <ellipse cx="64"  cy="128" rx="10" ry="4" fill="#7fb56e" />
    <ellipse cx="136" cy="128" rx="10" ry="4" fill="#7fb56e" />
    <!-- Tiny toes -->
    <circle cx="56"  cy="128" r="2.4" fill="#7fb56e" />
    <circle cx="60"  cy="131.5" r="2"   fill="#7fb56e" />
    <circle cx="144" cy="128" r="2.4" fill="#7fb56e" />
    <circle cx="140" cy="131.5" r="2"   fill="#7fb56e" />

    <!-- Eye bumps (sticking up from head) -->
    <circle cx="80"  cy="68" r="17" fill="url(#frogEye)" />
    <circle cx="120" cy="68" r="17" fill="url(#frogEye)" />
    <!-- Eye whites -->
    <circle cx="80"  cy="70" r="12" fill="#fefdf6" />
    <circle cx="120" cy="70" r="12" fill="#fefdf6" />
    <!-- Pupils (almond) -->
    <ellipse cx="80"  cy="72" rx="5.5" ry="6.5" fill="#1d3a4a" />
    <ellipse cx="120" cy="72" rx="5.5" ry="6.5" fill="#1d3a4a" />
    <!-- Primary highlight -->
    <circle cx="83"  cy="68" r="2.2" fill="#fefdf6" />
    <circle cx="123" cy="68" r="2.2" fill="#fefdf6" />
    <!-- Secondary highlight -->
    <circle cx="77"  cy="75" r="1"   fill="#fefdf6" opacity="0.75" />
    <circle cx="117" cy="75" r="1"   fill="#fefdf6" opacity="0.75" />

    <!-- Smile (gentle curve with corner ticks) -->
    <path d="M82 102 Q100 110 118 102"
          stroke="#1d3a4a" stroke-width="2" fill="none"
          stroke-linecap="round" />
    <circle cx="82"  cy="102" r="0.9" fill="#1d3a4a" />
    <circle cx="118" cy="102" r="0.9" fill="#1d3a4a" />

    <!-- Cheek blush -->
    <ellipse cx="67"  cy="96" rx="5" ry="2" fill="#f7c2cf" opacity="0.7" />
    <ellipse cx="133" cy="96" rx="5" ry="2" fill="#f7c2cf" opacity="0.7" />
  </svg>

  <!-- ─────────── DARK THEME · Distant orca ─────────── -->
  <svg
    class="art-orca"
    viewBox="0 0 480 220"
    width="380"
    height="174"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="orcaBody" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#22455c" />
        <stop offset="45%"  stop-color="#0e2533" />
        <stop offset="100%" stop-color="#06182a" />
      </linearGradient>
      <linearGradient id="orcaBelly" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#3a5c73" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#1d3a52" stop-opacity="0.45" />
      </linearGradient>
      <linearGradient id="orcaRay" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#d8e7ec" stop-opacity="0.50" />
        <stop offset="100%" stop-color="#d8e7ec" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- Surface light shafts -->
    <g opacity="0.55">
      <path d="M120 0 L92 220 L150 220 Z"  fill="url(#orcaRay)" />
      <path d="M290 0 L266 220 L312 220 Z" fill="url(#orcaRay)" />
      <path d="M380 0 L366 220 L394 220 Z" fill="url(#orcaRay)" opacity="0.7" />
    </g>

    <g transform="translate(240, 125)">
      <!-- Tail flukes (Y-shape) -->
      <path d="M -98 -3
               C -112 -10, -132 -22, -142 -28
               C -132 -16, -122 -8, -110 -3
               C -122 2,  -132 10, -142 24
               C -132 18, -112 8,  -98 3 Z"
            fill="url(#orcaBody)" />

      <!-- Body (sleek torpedo via bezier) -->
      <path d="M -108 0
               C -118 -12, -106 -22, -94 -24
               C -60 -32, -10 -36, 38 -26
               C 70 -22, 90 -14, 100 -5
               C 104 -2, 104 2, 100 6
               C 84 18, 60 26, 30 30
               C -12 36, -52 32, -88 22
               C -104 18, -118 10, -108 0 Z"
            fill="url(#orcaBody)" />

      <!-- White belly patch (custom shape) -->
      <path d="M -90 12
               C -65 26, -10 32, 32 26
               C 56 22, 76 16, 84 11
               C 64 22, 24 28, -16 26
               C -50 24, -78 18, -90 12 Z"
            fill="url(#orcaBelly)" />

      <!-- Saddle / eye patch (classic orca light patch) -->
      <ellipse cx="58" cy="-14" rx="16" ry="5"
               fill="#3a5c6d" opacity="0.62"
               transform="rotate(-8 58 -14)" />

      <!-- Eye dot -->
      <circle cx="66" cy="-10" r="1.5" fill="#06182a" />

      <!-- Dorsal fin (real proportion, slight curve back) -->
      <path d="M -8 -22
               C -10 -42, 6 -54, 20 -52
               C 28 -50, 30 -44, 26 -36
               C 22 -30, 12 -25, 4 -22 Z"
            fill="url(#orcaBody)" />

      <!-- Pectoral fin (paddle, in front-bottom) -->
      <path d="M 8 12
               C 0 18, -18 28, -28 30
               C -34 30, -32 22, -22 18
               C -10 14, 0 12, 8 12 Z"
            fill="#0a2030" />

      <!-- Subtle surface light on dorsal fin tip -->
      <path d="M 18 -52 C 22 -50, 23 -47, 22 -45"
            stroke="rgba(216, 231, 236, 0.18)" stroke-width="1" fill="none" />
    </g>
  </svg>
</div>

<style>
  .art-frog,
  .art-orca {
    position: absolute;
    transition: opacity 0.6s ease;
  }

  /* Frog: bottom-right corner, gentle hover-bob */
  .art-frog {
    right: 2rem;
    bottom: 1.25rem;
    opacity: 0;
    animation: bob 6s ease-in-out infinite;
    filter: drop-shadow(0 6px 18px rgba(29, 58, 74, 0.18));
  }
  :root[data-theme="light"] .art-frog { opacity: 1; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }

  /* Orca: drifts left ↔ right across the lower half, very slow */
  .art-orca {
    left: 0;
    bottom: 14vh;
    opacity: 0;
    animation: cruise 70s linear infinite;
    filter: blur(0.4px);
  }
  :root[data-theme="dark"] .art-orca { opacity: 0.65; }

  @keyframes cruise {
    0%   { transform: translateX(-22%) scale(0.92); }
    50%  { transform: translateX(72vw)  scale(1.02); }
    100% { transform: translateX(-22%) scale(0.92); }
  }

  /* Mobile: shrink both, tuck out of the way */
  @media (max-width: 640px) {
    .art-frog { right: 0.75rem; bottom: 0.75rem; width: 150px; height: 113px; }
    .art-orca { width: 260px; height: 119px; bottom: 9vh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-frog { animation: none; }
    .art-orca { animation: none; transform: translateX(40vw); }
  }
</style>
