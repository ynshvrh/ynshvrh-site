---
const projects = [
  {
    id: '001',
    codename: 'WIZALLET',
    name: 'WizAllet',
    desc: 'Simple personal finance tracker. Vue 3 web client backed by a Go (Gin + GORM) API on Postgres. Live in prod.',
    stack: ['Vue 3', 'Go', 'Postgres'],
    status: 'ACTIVE',
    links: [
      { label: 'LIVE', href: 'https://wizallet.netlify.app' },
      { label: 'WEB', href: 'https://github.com/ynshvrh/WizAllet' },
      { label: 'API', href: 'https://github.com/ynshvrh/wizallet-api' },
    ],
  },
  {
    id: '002',
    codename: 'V_FRIDGE',
    name: 'V-Fridge',
    desc: 'Food management with AI — track what you have and get smart cook suggestions. Web client, ASP.NET API, and Flutter mobile.',
    stack: ['TypeScript', 'C# / .NET', 'Flutter', 'AI'],
    status: 'ACTIVE',
    links: [
      { label: 'WEB', href: 'https://github.com/ynshvrh/V-Fridge' },
      { label: 'API', href: 'https://github.com/ynshvrh/v-fridge-api' },
      { label: 'MOB', href: 'https://github.com/ynshvrh/v-fridge-mobile' },
    ],
  },
  {
    id: '003',
    codename: 'AKADEM_VAULT',
    name: 'AkademVault',
    desc: 'Full-stack platform for managing academic records and materials. TypeScript web client talking to a C# / .NET API.',
    stack: ['TypeScript', 'C# / .NET', 'Docker'],
    status: 'PROTOTYPE',
    links: [
      { label: 'WEB', href: 'https://github.com/ynshvrh/AkademVault-Web' },
      { label: 'API', href: 'https://github.com/ynshvrh/AkademVault-API' },
    ],
  },
];
---

<section id="projects" class="section">
  <div class="container">
    <div class="section-label">
      <span class="idx">02</span>
      <span class="slash">//</span>
      <span class="name">PROJECTS.LOG</span>
      <span class="rule"></span>
      <span class="cnt">{projects.length} ENTRIES</span>
    </div>

    <div class="head">
      <h2 class="section-title">Selected <span class="gradient-text">Builds</span></h2>
      <p class="head-note mono">
        $ ls ~/projects ──→
        <a href="https://github.com/ynshvrh" target="_blank" rel="noopener noreferrer">github.com/ynshvrh</a>
      </p>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <article class="frame project">
          <span class="c-tl"></span><span class="c-br"></span>

          <header class="proj-head">
            <span class="proj-id">№ {p.id}</span>
            <span class={`chip ${p.status === 'ACTIVE' ? 'is-active' : 'is-purple'}`}>
              {p.status === 'ACTIVE' ? <span class="dot"></span> : null}
              {p.status}
            </span>
          </header>

          <h3 class="codename">{p.codename}</h3>
          <p class="proj-desc">{p.desc}</p>

          <dl class="kv proj-kv">
            <dt class="k">stack</dt>
            <dd class="v">{p.stack.join(' · ')}</dd>
            <dt class="k">links</dt>
            <dd class="v">
              <ul class="link-list">
                {p.links.map((l) => (
                  <li>
                    <a class="proj-link" href={l.href} target="_blank" rel="noopener noreferrer">
                      <span class="proj-link-lbl">[{l.label}]</span>
                      <span class="proj-link-arrow">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .head-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .head-note a { color: var(--cyan); }

  .section-label .cnt {
    color: var(--purple-soft);
    font-size: 0.66rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .project {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.15s ease;
  }
  .project:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px -25px var(--cyan);
  }

  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--line);
  }
  .proj-id {
    font-family: var(--mono);
    color: var(--text-mute);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
  }
  .chip .dot {
    width: 7px; height: 7px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
    animation: cdot 1.8s ease-in-out infinite;
  }
  @keyframes cdot { 0%,100%{opacity:1}50%{opacity:0.35} }

  .codename {
    font-family: var(--mono);
    font-size: 1.5rem;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--text);
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .proj-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-dim);
  }

  .proj-kv {
    margin: 0;
    align-items: start;
  }
  .proj-kv .v { font-size: 0.85rem; }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    color: var(--cyan-soft);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .proj-link:hover {
    color: var(--text);
    border-color: var(--purple);
    background: rgba(79, 183, 179, 0.08);
  }
  .proj-link-arrow {
    color: var(--purple);
    transition: transform 0.15s ease;
  }
  .proj-link:hover .proj-link-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>
