---
const projects = [
  {
    codename: 'V-Fridge',
    desc: 'Food management with AI — track what you have and get smart cook suggestions. Web client, ASP.NET API, Flutter mobile.',
    stack: ['TypeScript', 'C# / .NET', 'Flutter', 'AI'],
    status: 'active',
    links: [
      { label: 'Live',   href: 'https://v-fridge.vercel.app' },
      { label: 'Web',    href: 'https://github.com/ynshvrh/V-Fridge' },
      { label: 'API',    href: 'https://github.com/ynshvrh/v-fridge-api' },
      { label: 'Mobile', href: 'https://github.com/ynshvrh/v-fridge-mobile' },
    ],
  },
  {
    codename: 'AkademVault',
    desc: 'Student group coordination platform — real-time chat, file storage, and AI schedule parsing from a photo or PDF. Angular + Capacitor client, C# / .NET API. My bachelor thesis project.',
    stack: ['Angular', 'Capacitor', 'C# / .NET', 'PostgreSQL', 'AI'],
    status: 'demo',
    links: [
      { label: 'Live', href: 'https://akademvault.pages.dev' },
      { label: 'Web',  href: 'https://github.com/ynshvrh/AkademVault-Web' },
      { label: 'API',  href: 'https://github.com/ynshvrh/AkademVault-API' },
    ],
  },
  {
    codename: 'WizAllet',
    desc: 'Personal finance tracker. Vue 3 web client backed by a Go (Gin + GORM) API on Postgres. A finished portfolio case.',
    stack: ['Vue 3', 'Go', 'Postgres'],
    status: 'shipped',
    links: [
      { label: 'Live', href: 'https://wizallet.netlify.app' },
      { label: 'Web',  href: 'https://github.com/ynshvrh/WizAllet' },
      { label: 'API',  href: 'https://github.com/ynshvrh/wizallet-api' },
    ],
  },
];
---

<section id="projects" class="section">
  <div class="container">
    <div class="head">
      <h2 class="section-title">Projects</h2>
      <a class="head-link" href="https://github.com/ynshvrh" target="_blank" rel="noopener noreferrer">
        github.com/ynshvrh ↗
      </a>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <article class="project glowing-card">
          <header class="proj-head">
            <h3 class="codename">{p.codename}</h3>
            <span class={`status status-${p.status}`}>
              <span class="status-dot" aria-hidden="true"></span>
              {p.status}
            </span>
          </header>

          <p class="proj-desc">{p.desc}</p>

          <ul class="stack-list" aria-label="Stack">
            {p.stack.map((s) => <li>{s}</li>)}
          </ul>

          <ul class="link-list" aria-label="Links">
            {p.links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .head-link {
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .head-link:hover { color: var(--accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .project {
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project:hover {
    transform: translateY(-3px);
  }

  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .codename {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .status-active {
    color: var(--accent);
    background: var(--accent-tint);
  }
  .status-active .status-dot {
    animation: pulse 2s ease-in-out infinite;
  }
  .status-prototype {
    color: var(--text-mute);
    background: var(--surface);
  }
  /* shipped = live but no longer actively developed (e.g. a portfolio case).
     demo = a live showcase / thesis project, not a product in active dev.
     Both are calm — accent-soft, no pulsing dot. */
  .status-shipped,
  .status-demo {
    color: var(--accent-soft);
    background: var(--accent-tint);
  }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: 0.35 } }

  .proj-desc {
    color: var(--text-dim);
    margin: 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .stack-list, .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stack-list li {
    font-size: 0.72rem;
    color: var(--text-mute);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--surface);
  }
  .link-list { margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--line); }
  .link-list a {
    font-size: 0.82rem;
    color: var(--text-dim);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .link-list a:hover {
    color: var(--accent);
    background: var(--accent-tint);
  }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
