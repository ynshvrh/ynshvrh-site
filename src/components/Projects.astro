---
const projects = [
  {
    codename: 'E-Fridge',
    badge: 'Featured · Flagship',
    desc: 'AI-powered virtual food storage app (rewritten & evolved from V-Fridge) — inventory tracking with expiry monitoring, smart AI recipe suggestions, automated shopping lists, and meal planning.',
    stack: ['Go', 'Vue.js', 'PostgreSQL', 'JWT', 'Google OAuth', 'Docker'],
    status: 'live',
    statusLabel: 'live app',
    links: [
      { label: 'Live App', href: 'https://e-fridge.pages.dev' },
      { label: 'Web Repository', href: 'https://github.com/ynshvrh/E-Fridge' },
      { label: 'Backend API', href: 'https://github.com/ynshvrh/E-Fridge-Api' },
    ],
  },
  {
    codename: 'AkademVault',
    badge: 'Diploma / Thesis Project',
    desc: 'Student group management & coordination platform — real-time messenger with SignalR, cloud file storage, academic planner, and AI schedule parsing from photos or PDFs.',
    stack: ['C# / .NET 10', 'ASP.NET Core', 'Angular', 'PostgreSQL', 'SignalR', 'GraphQL'],
    status: 'demo',
    statusLabel: 'demo available',
    links: [
      { label: 'Live Demo', href: 'https://akademvault.pages.dev' },
      { label: 'Web Repository', href: 'https://github.com/ynshvrh/AkademVault-Web' },
      { label: 'Backend API', href: 'https://github.com/ynshvrh/AkademVault-API' },
    ],
  },
];
---

<section id="projects" class="section">
  <div class="container">
    <div class="head">
      <h2 class="section-title">Projects</h2>
      <p class="head-sub">Selected production and architectural showcases</p>
      <a class="head-link tag-terminal" href="https://github.com/ynshvrh" target="_blank" rel="noopener noreferrer">
        github.com/ynshvrh ↗
      </a>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <article class="project glowing-card">
          <header class="proj-head">
            <div>
              <span class="proj-badge tag-terminal">{p.badge}</span>
              <h3 class="codename">{p.codename}</h3>
            </div>
            <span class={`status status-${p.status}`}>
              <span class="status-dot" aria-hidden="true"></span>
              {p.statusLabel}
            </span>
          </header>

          <p class="proj-desc">{p.desc}</p>

          <div class="proj-footer">
            <ul class="stack-list" aria-label="Stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>

            <ul class="link-list" aria-label="Links">
              {p.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class={l.label.includes('Live') ? 'link-live' : ''}>
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 2.75rem;
    text-align: center;
  }
  .head-sub {
    font-size: 0.95rem;
    color: var(--text-dim);
    margin: 0;
  }
  .head-link {
    font-size: 0.85rem;
    color: var(--accent-secondary-soft);
    margin-top: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--amber-tint);
    border: 1px solid rgba(245, 158, 11, 0.25);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .head-link:hover {
    background: var(--amber-tint-strong);
    border-color: var(--accent-secondary);
    color: #fff;
    transform: translateY(-1px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project {
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .project:hover {
    transform: translateY(-3px);
  }

  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .proj-badge {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--accent-secondary-soft);
    margin-bottom: 0.3rem;
  }
  .codename {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    font-family: var(--mono);
    text-transform: lowercase;
    letter-spacing: 0.02em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .status-live,
  .status-active {
    color: var(--accent-secondary-soft);
    background: var(--amber-tint);
    border: 1px solid rgba(245, 158, 11, 0.35);
  }
  .status-live .status-dot,
  .status-active .status-dot {
    animation: pulse 2s ease-in-out infinite;
  }
  .status-demo {
    color: var(--accent-soft);
    background: var(--accent-tint);
    border: 1px solid rgba(168, 85, 247, 0.3);
  }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: 0.35 } }

  .proj-desc {
    color: var(--text-dim);
    margin: 0;
    line-height: 1.65;
    font-size: 0.96rem;
  }

  .proj-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-list, .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stack-list li {
    font-size: 0.75rem;
    font-family: var(--mono);
    color: var(--text-dim);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(168, 85, 247, 0.05);
    border: 1px solid rgba(168, 85, 247, 0.15);
  }

  .link-list {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    gap: 0.6rem;
  }
  .link-list a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-dim);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .link-list a:hover {
    color: #fff;
    background: var(--accent-tint-strong);
    border-color: var(--accent-soft);
  }
  .link-list a.link-live {
    color: var(--accent-secondary-soft);
    background: var(--amber-tint);
    border-color: rgba(245, 158, 11, 0.35);
  }
  .link-list a.link-live:hover {
    color: #ffffff;
    background: var(--amber-tint-strong);
    border-color: var(--accent-secondary);
  }

  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
