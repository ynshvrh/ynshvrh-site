---
const dossier = [
  { k: 'Role',           v: 'Software Engineer' },
  { k: 'Focus',          v: 'C# / .NET · Angular · Flutter' },
  { k: 'Commercial exp', v: 'Go · Vue' },
  { k: 'Learning',       v: 'Rust · for myself' },
  { k: 'Databases',      v: 'PostgreSQL · MongoDB · SQLite' },
  { k: 'Location',       v: 'Kyiv / Ukraine' },
  { k: 'Status',         v: 'Open to work' },
];
---

<section id="about" class="section">
  <div class="container">
    <h2 class="section-title">About</h2>

    <div class="about-grid">
      <div class="about-copy">
        <p>
          I care about clean APIs, predictable systems, and codebases that
          prize clarity over cleverness.
        </p>
        <p>
          Most of what I know came from building real things rather than
          following tutorials. Based in Kyiv, Ukraine, and looking for my
          next role.
        </p>
      </div>

      <aside class="dossier">
        <dl>
          {dossier.map((row) => (
            <>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </>
          ))}
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-copy p {
    max-width: 58ch;
    color: var(--text-dim);
    line-height: 1.75;
    margin: 0 0 1rem;
  }
  .about-copy strong {
    color: var(--accent);
    font-weight: 600;
  }

  .dossier {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
  }
  .dossier dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1.5rem;
    row-gap: 0.7rem;
  }
  .dossier dt {
    color: var(--text-mute);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    font-weight: 500;
    padding-top: 0.1rem;
  }
  .dossier dd {
    margin: 0;
    color: var(--text);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
