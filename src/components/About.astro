---
const dossier = [
  { k: 'name',     v: 'Yanosh / Janos' },
  { k: 'role',     v: 'Full-stack engineer · backend-leaning' },
  { k: 'stack',    v: 'TypeScript · C# / .NET' },
  { k: 'learning', v: 'Go · Rust' },
  { k: 'location', v: 'Kyiv / Ukraine' },
  { k: 'status',   v: 'open for collab' },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="section-label">
      <span class="idx">01</span>
      <span class="slash">//</span>
      <span class="name">ABOUT.MD</span>
      <span class="rule"></span>
    </div>

    <div class="about-grid">
      <div class="about-copy">
        <h2 class="section-title">
          Backend-oriented<br />
          <span class="gradient-text">full-stack</span> developer.
        </h2>
        <p>
          Focused on <span class="hl-c">TypeScript</span> and
          <span class="hl-p">C# / .NET</span>. I like clean APIs, predictable
          systems, and codebases that prize clarity over cleverness.
        </p>
        <p>
          Interested in systems programming, currently exploring
          <span class="hl-c">Go</span> and <span class="hl-p">Rust</span>.
          Based in Kyiv, Ukraine.
        </p>
        <p class="signature mono">
          &gt; cat /etc/yanosh<span class="cursor"></span>
        </p>
      </div>

      <aside class="dossier frame">
        <span class="c-tl"></span><span class="c-br"></span>
        <header class="dossier-head">
          <span class="chip is-purple">ID 0x59 — RECORD</span>
          <span class="dossier-id">#001/2026</span>
        </header>
        <dl class="kv">
          {dossier.map((row) => (
            <>
              <dt class="k">{row.k}</dt>
              <dd class="v">{row.v}</dd>
            </>
          ))}
        </dl>
        <footer class="dossier-foot mono">
          <span>SIG · ynshvrh</span>
          <span class="vbar">|</span>
          <span>VER 1.0</span>
        </footer>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-copy p {
    max-width: 56ch;
  }

  .hl-c { color: var(--cyan); font-weight: 600; }
  .hl-p { color: var(--purple-soft); font-weight: 600; }

  .signature {
    color: var(--cyan-soft);
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .dossier {
    padding: 1.5rem;
  }
  .dossier-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--line);
  }
  .dossier-id {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.18em;
  }
  dl.kv { margin: 0; }
  dl.kv dd { margin: 0; }
  .dossier-foot {
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    display: flex;
    gap: 0.85rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--text-mute);
    text-transform: uppercase;
  }
  .vbar { color: var(--purple); }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
