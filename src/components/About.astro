---
const dossier = [
  { k: 'Role',        v: 'Backend & Software Engineer' },
  { k: 'Backend',     v: 'C# (.NET) · Go (Golang)' },
  { k: 'Frontend',    v: 'Angular · Vue.js · TypeScript' },
  { k: 'Databases',   v: 'PostgreSQL · MongoDB · SQLite' },
  { k: 'Location',    v: 'Kyiv / Ukraine' },
  { k: 'Status',      v: 'Open to work' },
];
---

<section id="about" class="section">
  <div class="container">
    <h2 class="section-title">About</h2>

    <div class="about-grid">
      <div class="about-copy">
        <p>
          I am a software engineer focused on building robust, scalable backends and clean APIs.
          My primary strengths are <strong>C# (.NET 10)</strong> and <strong>Go (Golang)</strong>, with EF Core, Minimal APIs, and high-concurrency microservices.
        </p>
        <p>
          I also bring practical client-side experience with Angular and Vue 3, ensuring seamless 
          end-to-end full-stack integration when needed. Based in Kyiv, Ukraine, and actively looking for my next role.
        </p>
      </div>

      <aside class="dossier glowing-card">
        <dl>
          {dossier.map((row) => (
            <>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </>
          ))}
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-top: 2rem;
  }

  .about-copy p {
    max-width: 58ch;
    color: var(--text-dim);
    line-height: 1.75;
    margin: 0 0 1rem;
    font-size: 1.02rem;
  }
  .about-copy strong {
    color: var(--accent-soft);
    font-weight: 600;
  }

  .dossier {
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
  }
  .dossier dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1.5rem;
    row-gap: 0.8rem;
  }
  .dossier dt {
    color: var(--text-mute);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    font-weight: 600;
    text-transform: uppercase;
    padding-top: 0.1rem;
  }
  .dossier dd {
    margin: 0;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
