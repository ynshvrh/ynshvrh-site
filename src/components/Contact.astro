---
const email = 'varga.yanosh.05@gmail.com';
const channels = [
  { label: 'Telegram', handle: '@ynshvrh',    href: 'https://t.me/ynshvrh' },
  { label: 'Email',    handle: email,         href: `mailto:${email}` },
  { label: 'LinkedIn', handle: '/in/ynshvrh', href: 'https://www.linkedin.com/in/ynshvrh' },
  { label: 'GitHub',   handle: '@ynshvrh',    href: 'https://github.com/ynshvrh' },
];
---

<section id="contact" class="section">
  <div class="container">
    <h2 class="section-title">Get in touch</h2>
    <p class="lead">
      Working on something interesting? Drop a line.
    </p>

    <div class="contact-card">
      <a class="primary-line" href={`mailto:${email}`}>
        <span class="pl-label">Email</span>
        <span class="pl-value">{email}</span>
        <span class="pl-arrow" aria-hidden="true">→</span>
      </a>

      <ul class="channels">
        {channels.map((c) => (
          <li>
            <a class="ch-row" href={c.href} target="_blank" rel="noopener noreferrer">
              <span class="ch-label">{c.label}</span>
              <span class="ch-handle">{c.handle}</span>
              <span class="ch-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .lead {
    color: var(--text-dim);
    margin: 0 0 1.75rem;
    font-size: 1.05rem;
  }

  .contact-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.75rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
  }

  .primary-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: var(--accent-tint);
    color: var(--text);
    margin-bottom: 1.25rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .primary-line:hover {
    background: var(--accent-tint-strong);
    transform: translateY(-1px);
  }
  .pl-label {
    font-size: 0.78rem;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pl-value { flex: 1; color: var(--text); font-weight: 500; }
  .pl-arrow { color: var(--accent); font-weight: 600; }

  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .channels li + li { border-top: 1px solid var(--line); }

  .ch-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0.5rem;
    color: var(--text-dim);
    transition: color 0.2s ease, padding-left 0.2s ease, background 0.2s ease;
    border-radius: 8px;
  }
  .ch-row:hover {
    color: var(--text);
    padding-left: 0.85rem;
    background: var(--surface-hover);
  }
  .ch-label {
    color: var(--text);
    font-weight: 500;
  }
  .ch-handle { font-size: 0.92rem; }
  .ch-arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .ch-row:hover .ch-arrow { transform: translate(3px, -3px); }

  @media (max-width: 560px) {
    .ch-row {
      grid-template-columns: 100px 1fr auto;
      gap: 0.5rem;
      font-size: 0.88rem;
    }
    .primary-line { flex-wrap: wrap; }
  }
</style>
