---
const email = 'ynshvrh@gmail.com';
const channels = [
  { 
    label: 'Telegram', 
    handle: '@ynshvrh',    
    href: 'https://t.me/ynshvrh',
    icon: 'telegram'
  },
  { 
    label: 'Email',    
    handle: email,         
    href: `mailto:${email}`,
    icon: 'email'
  },
  { 
    label: 'LinkedIn', 
    handle: '/in/ynshvrh', 
    href: 'https://www.linkedin.com/in/ynshvrh',
    icon: 'linkedin'
  },
  { 
    label: 'GitHub',   
    handle: '@ynshvrh',    
    href: 'https://github.com/ynshvrh',
    icon: 'github'
  },
];
---

<section id="contact" class="section">
  <div class="container">
    <h2 class="section-title">Get in touch</h2>
    <p class="lead">
      I'm open to work — looking for my next role, full-time or contract.
      Email or LinkedIn is the fastest way to reach me.
    </p>

    <div class="contact-card glowing-card">
      <a class="primary-line" href={`mailto:${email}`}>
        <svg class="pl-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span class="pl-label">Email</span>
        <span class="pl-value">{email}</span>
        <span class="pl-arrow" aria-hidden="true">→</span>
      </a>

      <ul class="channels">
        {channels.map((c) => (
          <li>
            <a class="ch-row" href={c.href} target="_blank" rel="noopener noreferrer">
              <span class="ch-label-col">
                {c.icon === 'telegram' && (
                  <svg class="ch-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                )}
                {c.icon === 'email' && (
                  <svg class="ch-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                )}
                {c.icon === 'linkedin' && (
                  <svg class="ch-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                )}
                {c.icon === 'github' && (
                  <svg class="ch-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                )}
                <span class="ch-label">{c.label}</span>
              </span>
              <span class="ch-handle">{c.handle}</span>
              <span class="ch-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .lead {
    color: var(--text-dim);
    margin: 0 auto 1.75rem;
    font-size: 1.05rem;
    text-align: center;
    max-width: 540px;
  }

  .contact-card {
    border-radius: 16px;
    padding: 1.75rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--card-shadow);
  }

  .primary-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: var(--accent-tint);
    color: var(--text);
    margin-bottom: 1.25rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    animation: email-glow 4s ease-in-out infinite alternate;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }
  .primary-line:hover {
    background: var(--accent-tint-strong);
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
  }
  @keyframes email-glow {
    0% {
      box-shadow: 0 0 6px rgba(16, 185, 129, 0.15);
      border-color: rgba(16, 185, 129, 0.2);
    }
    100% {
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.25);
      border-color: rgba(139, 92, 246, 0.4);
    }
  }
  .pl-label {
    font-size: 0.78rem;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pl-value { flex: 1; color: var(--text); font-weight: 500; }
  .pl-arrow { color: var(--accent); font-weight: 600; }
  .pl-icon {
    color: var(--accent);
  }

  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .channels li + li { border-top: 1px solid var(--line); }

  .ch-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0.5rem;
    color: var(--text-dim);
    transition: color 0.2s ease, padding-left 0.2s ease, background 0.2s ease;
    border-radius: 8px;
  }
  .ch-row:hover {
    color: var(--text);
    padding-left: 0.85rem;
    background: var(--surface-hover);
  }
  .ch-label-col {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .ch-icon {
    color: var(--text-mute);
    transition: color 0.2s ease;
  }
  .ch-row:hover .ch-icon {
    color: var(--accent);
  }
  .ch-label {
    color: var(--text);
    font-weight: 500;
  }
  .ch-handle { font-size: 0.92rem; }
  .ch-arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .ch-row:hover .ch-arrow { transform: translate(3px, -3px); }

  @media (max-width: 560px) {
    .ch-row {
      grid-template-columns: 120px 1fr auto;
      gap: 0.5rem;
      font-size: 0.88rem;
    }
    .primary-line { flex-wrap: wrap; }
  }
</style>
