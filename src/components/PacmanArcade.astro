---
---

<!-- Ambient Soft Blurred Retro Arcade Background Layer -->
<div class="blurred-arcade-bg" aria-hidden="true">
  <!-- Top Arcade Drift Level -->
  <div class="arcade-drift-track track-top">
    <div class="drift-group group-a">
      <!-- Pac-Man SVG -->
      <div class="arcade-shape shape-pacman">
        <svg width="40" height="40" viewBox="0 0 32 32">
          <path class="jaw-top" fill="#fbbf24" d="M 16 16 L 30 16 A 14 14 0 0 0 16 2 Z" />
          <path class="jaw-bottom" fill="#fbbf24" d="M 16 16 L 30 16 A 14 14 0 0 1 16 30 Z" />
        </svg>
      </div>

      <!-- Blinky Ghost (Red) -->
      <div class="arcade-shape shape-ghost ghost-red">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C7 2 3 6 3 11v11l3-3 3 3 3-3 3 3V11c0-5-4-9-9-9z" fill="#ef4444"/>
          <circle cx="8" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="9" cy="10" r="1.2" fill="#0f172a"/>
          <circle cx="16" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="17" cy="10" r="1.2" fill="#0f172a"/>
        </svg>
      </div>

      <!-- Inky Ghost (Blue) -->
      <div class="arcade-shape shape-ghost ghost-blue">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C7 2 3 6 3 11v11l3-3 3 3 3-3 3 3V11c0-5-4-9-9-9z" fill="#3b82f6"/>
          <circle cx="8" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="9" cy="10" r="1.2" fill="#0f172a"/>
          <circle cx="16" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="17" cy="10" r="1.2" fill="#0f172a"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Bottom Arcade Drift Level -->
  <div class="arcade-drift-track track-bottom">
    <div class="drift-group group-b">
      <!-- Pinky Ghost (Pink) -->
      <div class="arcade-shape shape-ghost ghost-pink">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C7 2 3 6 3 11v11l3-3 3 3 3-3 3 3V11c0-5-4-9-9-9z" fill="#f472b6"/>
          <circle cx="8" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="7" cy="10" r="1.2" fill="#0f172a"/>
          <circle cx="16" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="15" cy="10" r="1.2" fill="#0f172a"/>
        </svg>
      </div>

      <!-- Space Invader Shape -->
      <div class="arcade-shape shape-invader">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="#ef4444">
          <path d="M7 2h10v2H7zM5 4h14v2H5zM3 6h18v6H3zM1 12h5v4H1zM18 12h5v4h-5zM5 16h2v6H5zM17 16h2v6h-2z" />
        </svg>
      </div>

      <!-- Clyde Ghost (Orange) -->
      <div class="arcade-shape shape-ghost ghost-orange">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C7 2 3 6 3 11v11l3-3 3 3 3-3 3 3V11c0-5-4-9-9-9z" fill="#fb923c"/>
          <circle cx="8" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="9" cy="10" r="1.2" fill="#0f172a"/>
          <circle cx="16" cy="10" r="2.5" fill="#ffffff"/>
          <circle cx="17" cy="10" r="1.2" fill="#0f172a"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .blurred-arcade-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    filter: blur(20px);
    opacity: 0.28;
  }

  .arcade-drift-track {
    position: absolute;
    left: 0;
    width: 100%;
    height: 60px;
  }
  .track-top {
    top: 25%;
  }
  .track-bottom {
    top: 70%;
  }

  .drift-group {
    position: absolute;
    top: 0;
    display: flex;
    align-items: center;
    gap: 60px;
    will-change: transform;
  }

  .group-a {
    left: -200px;
    animation: drift-right 28s linear infinite;
  }
  .group-b {
    right: -200px;
    animation: drift-left 34s linear infinite;
  }

  @keyframes drift-right {
    0% { left: -240px; }
    100% { left: calc(100% + 80px); }
  }
  @keyframes drift-left {
    0% { right: -240px; }
    100% { right: calc(100% + 80px); }
  }

  .arcade-shape {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* SVG Pacman mouth animation */
  .jaw-top {
    transform-origin: 16px 16px;
    animation: chomp-top 0.3s ease-in-out infinite alternate;
  }
  .jaw-bottom {
    transform-origin: 16px 16px;
    animation: chomp-bottom 0.3s ease-in-out infinite alternate;
  }
  @keyframes chomp-top {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(-35deg); }
  }
  @keyframes chomp-bottom {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(35deg); }
  }

  /* Shape glows */
  .shape-pacman svg { filter: drop-shadow(0 0 12px #fbbf24); }
  .ghost-red svg { filter: drop-shadow(0 0 12px #ef4444); }
  .ghost-blue svg { filter: drop-shadow(0 0 12px #3b82f6); }
  .ghost-pink svg { filter: drop-shadow(0 0 12px #f472b6); }
  .ghost-orange svg { filter: drop-shadow(0 0 12px #fb923c); }
  .shape-invader svg { filter: drop-shadow(0 0 12px #ef4444); }

  @media (prefers-reduced-motion: reduce) {
    .blurred-arcade-bg { display: none; }
  }
</style>
