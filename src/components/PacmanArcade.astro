---
---

<!-- Arcade Modal Overlay (Hidden by default, triggered by 1UP badge) -->
<div id="arcade-modal" class="arcade-modal-overlay" aria-hidden="true">
  <div class="arcade-modal-container glowing-card">
    <!-- Header Controls -->
    <div class="modal-header">
      <div class="arcade-title">
        <span class="arcade-logo">🕹️ YNSHVRH 8-BIT ARCADE</span>
        <span class="arcade-status">INSERT COIN [PLAY]</span>
      </div>
      <button id="arcade-close-btn" class="close-btn" aria-label="Close Arcade Modal">×</button>
    </div>

    <!-- CRT Cabinet Screen -->
    <div class="crt-screen">
      <div class="crt-scanlines"></div>

      <!-- Score Bar -->
      <div class="arcade-score-bar">
        <div class="score-item">1UP <span id="game-score">0000</span></div>
        <div class="score-item">HIGH <span id="game-high">99990</span></div>
        <div class="score-item">LIVES <span id="game-lives">3</span></div>
      </div>

      <!-- Play Canvas -->
      <canvas id="arcade-canvas" width="480" height="320"></canvas>

      <!-- Overlay Game Start / Over screen -->
      <div id="arcade-start-overlay" class="game-overlay">
        <div class="overlay-content">
          <h3 class="game-headline">PAC-MAN RETRO ESCAPE</h3>
          <p class="game-instructions">Use Arrow Keys / WASD or Touch D-Pad to move Pac-Man and eat dots!</p>
          <button id="start-game-btn" class="btn btn-primary">START GAME</button>
        </div>
      </div>
    </div>

    <!-- Touch Mobile D-Pad Controls -->
    <div class="dpad-controls">
      <button class="dpad-btn dpad-up" data-dir="up">▲</button>
      <div class="dpad-row">
        <button class="dpad-btn dpad-left" data-dir="left">◀</button>
        <button class="dpad-btn dpad-right" data-dir="right">▶</button>
      </div>
      <button class="dpad-btn dpad-down" data-dir="down">▼</button>
    </div>
  </div>
</div>

<style>
  .arcade-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(4, 6, 10, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .arcade-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .arcade-modal-container {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: rgba(11, 15, 25, 0.95);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.9), 0 0 40px rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .arcade-title {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .arcade-logo {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.05em;
  }
  .arcade-status {
    font-size: 0.7rem;
    color: var(--accent-soft);
    font-family: var(--mono);
  }
  .close-btn {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text-dim);
    font-size: 1.4rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    line-height: 1;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .close-btn:hover {
    color: #ffffff;
    background: rgba(239, 68, 68, 0.3);
  }

  /* CRT Screen Container */
  .crt-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    background: #04060a;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(59, 130, 246, 0.4);
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
  }
  .crt-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 50%, rgba(0, 0, 0, 0.25) 50%);
    background-size: 100% 4px;
  }

  .arcade-score-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: #080c16;
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-mute);
    z-index: 2;
  }
  .score-item span {
    color: #fbbf24;
    font-weight: 700;
  }

  #arcade-canvas {
    width: 100%;
    height: 100%;
    background: #060911;
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    z-index: 6;
    background: rgba(6, 9, 17, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    transition: opacity 0.3s ease;
  }
  .game-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }
  .overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .game-headline {
    font-family: var(--mono);
    font-size: 1.1rem;
    color: #fbbf24;
    margin: 0;
    letter-spacing: 0.05em;
  }
  .game-instructions {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0;
    max-width: 320px;
  }

  /* D-Pad for Mobile */
  .dpad-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1rem;
  }
  .dpad-row {
    display: flex;
    gap: 1.5rem;
  }
  .dpad-btn {
    width: 44px;
    height: 40px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 8px;
    font-size: 1.1rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    touch-action: manipulation;
  }
  .dpad-btn:active {
    background: var(--accent-tint-strong);
    color: #ffffff;
  }

  @media (min-width: 640px) {
    .dpad-controls { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var modal = document.getElementById('arcade-modal');
    var closeBtn = document.getElementById('arcade-close-btn');
    var startBtn = document.getElementById('start-game-btn');
    var overlay = document.getElementById('arcade-start-overlay');
    var canvas = document.getElementById('arcade-canvas');
    if (!modal || !canvas) return;

    var ctx = canvas.getContext('2d');
    var scoreEl = document.getElementById('game-score');
    var livesEl = document.getElementById('game-lives');

    var gameRunning = false;
    var score = 0;
    var lives = 3;

    // Pacman State
    var pacman = { x: 240, y: 160, size: 10, speed: 2.5, dx: 0, dy: 0, mouth: 0.2, mouthSpeed: 0.05 };

    // Ghosts
    var ghosts = [
      { x: 60, y: 60, color: '#ef4444', dx: 2, dy: 1 },
      { x: 420, y: 260, color: '#3b82f6', dx: -2, dy: -1 }
    ];

    // Food Dots
    var dots = [];
    function initDots() {
      dots = [];
      for (var r = 30; r < 290; r += 28) {
        for (var c = 30; c < 450; c += 28) {
          dots.push({ x: c, y: r, active: true });
        }
      }
    }

    function openModal() {
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      initDots();
      drawInitial();
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      gameRunning = false;
    }

    // Export window trigger
    window.openArcadeModal = openModal;

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Keyboard Controls
    document.addEventListener('keydown', function (e) {
      if (!gameRunning) return;
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') { pacman.dx = 0; pacman.dy = -pacman.speed; }
      else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') { pacman.dx = 0; pacman.dy = pacman.speed; }
      else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') { pacman.dx = -pacman.speed; pacman.dy = 0; }
      else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') { pacman.dx = pacman.speed; pacman.dy = 0; }
    });

    // D-Pad Touch Controls
    document.querySelectorAll('.dpad-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!gameRunning) return;
        var dir = btn.dataset.dir;
        if (dir === 'up') { pacman.dx = 0; pacman.dy = -pacman.speed; }
        if (dir === 'down') { pacman.dx = 0; pacman.dy = pacman.speed; }
        if (dir === 'left') { pacman.dx = -pacman.speed; pacman.dy = 0; }
        if (dir === 'right') { pacman.dx = pacman.speed; pacman.dy = 0; }
      });
    });

    function drawInitial() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      // Draw grid maze lines
      ctx.strokeStyle = 'rgba(59, 130, 246, 0.2)';
      ctx.lineWidth = 1;
      for (var x = 0; x < canvas.width; x += 40) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
      }
      for (var y = 0; y < canvas.height; y += 40) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
      }

      // Draw Dots
      dots.forEach(function (d) {
        if (d.active) {
          ctx.fillStyle = '#ef4444';
          ctx.beginPath(); ctx.arc(d.x, d.y, 2.5, 0, Math.PI * 2); ctx.fill();
        }
      });
    }

    startBtn.addEventListener('click', function () {
      overlay.classList.add('hidden');
      score = 0;
      lives = 3;
      scoreEl.textContent = '0000';
      livesEl.textContent = '3';
      pacman.x = 240; pacman.y = 160; pacman.dx = pacman.speed; pacman.dy = 0;
      gameRunning = true;
      gameLoop();
    });

    function gameLoop() {
      if (!gameRunning) return;

      // Update Pacman
      pacman.x += pacman.dx;
      pacman.y += pacman.dy;

      // Bounce screen edges
      if (pacman.x < 15) { pacman.x = 15; pacman.dx = -pacman.dx; }
      if (pacman.x > canvas.width - 15) { pacman.x = canvas.width - 15; pacman.dx = -pacman.dx; }
      if (pacman.y < 15) { pacman.y = 15; pacman.dy = -pacman.dy; }
      if (pacman.y > canvas.height - 15) { pacman.y = canvas.height - 15; pacman.dy = -pacman.dy; }

      // Eat dots
      dots.forEach(function (d) {
        if (d.active && Math.hypot(pacman.x - d.x, pacman.y - d.y) < 12) {
          d.active = false;
          score += 10;
          scoreEl.textContent = String(score).padStart(4, '0');
        }
      });

      // Update Ghosts
      ghosts.forEach(function (g) {
        g.x += g.dx;
        g.y += g.dy;
        if (g.x < 20 || g.x > canvas.width - 20) g.dx = -g.dx;
        if (g.y < 20 || g.y > canvas.height - 20) g.dy = -g.dy;

        // Ghost collision
        if (Math.hypot(pacman.x - g.x, pacman.y - g.y) < 14) {
          lives--;
          livesEl.textContent = String(lives);
          pacman.x = 240; pacman.y = 160;
          if (lives <= 0) {
            gameRunning = false;
            overlay.classList.remove('hidden');
          }
        }
      });

      // Render Frame
      drawInitial();

      // Render Pacman
      ctx.fillStyle = '#fbbf24';
      ctx.shadowColor = '#fbbf24';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      var angle = Math.atan2(pacman.dy, pacman.dx);
      ctx.arc(pacman.x, pacman.y, pacman.size, angle + 0.3, angle + Math.PI * 2 - 0.3);
      ctx.lineTo(pacman.x, pacman.y);
      ctx.fill();
      ctx.shadowBlur = 0;

      // Render Ghosts
      ghosts.forEach(function (g) {
        ctx.fillStyle = g.color;
        ctx.shadowColor = g.color;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(g.x, g.y, 9, Math.PI, 0, false);
        ctx.lineTo(g.x + 9, g.y + 10);
        ctx.lineTo(g.x - 9, g.y + 10);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      requestAnimationFrame(gameLoop);
    }
  })();
</script>
