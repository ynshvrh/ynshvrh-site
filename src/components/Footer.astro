---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="cell">
      <span class="key">SYS</span>
      <span class="val">ynshvrh<span class="dot">.</span>dev</span>
    </div>
    <div class="cell">
      <span class="key">YEAR</span>
      <span class="val">© {year}</span>
    </div>
    <div class="cell">
      <span class="key">STACK</span>
      <span class="val">Astro · CSS</span>
    </div>
    <div class="cell palette">
      <span class="sw c"></span>
      <span class="sw p"></span>
      <span class="key">CYAN // PURPLE</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding-block: 1.25rem;
    background: rgba(7, 7, 15, 0.7);
    backdrop-filter: blur(10px);
    position: relative;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--purple), transparent);
    opacity: 0.5;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--text-mute);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cell {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .key { color: var(--purple); font-size: 0.64rem; letter-spacing: 0.22em; }
  .val { color: var(--text-dim); }
  .dot { color: var(--cyan); }

  .palette { gap: 0.45rem; }
  .sw { width: 10px; height: 10px; display: inline-block; }
  .sw.c { background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
  .sw.p { background: var(--purple); box-shadow: 0 0 8px var(--purple); }
</style>
