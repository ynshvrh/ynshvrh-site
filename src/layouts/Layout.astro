---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PacmanArcade from '../components/PacmanArcade.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yanosh — Backend & Software Engineer',
  description = 'Personal site of Yanosh (Janos) — software engineer open to work. Specializing in C# (.NET) and Go (Golang) backend development. Based in Kyiv.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Ambient Depth: dual aurora glows, cyber grid pattern -->
    <div class="glow" aria-hidden="true"></div>
    <div class="cyber-grid" aria-hidden="true"></div>

    <!-- Cyber Crosshair & Spark Trail Canvas -->
    <canvas class="spark-trail-canvas" aria-hidden="true"></canvas>
    <div class="cyber-crosshair" aria-hidden="true">
      <span class="ch-center"></span>
      <span class="ch-ring"></span>
    </div>

    <!-- Pac-Man & Ghost Retro Arcade Track -->
    <PacmanArcade />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <style is:global>
      /* Canvas for particle sparks trail */
      .spark-trail-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9998;
      }

      /* Custom Cyber Crosshair */
      .cyber-crosshair {
        position: fixed;
        top: 0;
        left: 0;
        width: 26px;
        height: 26px;
        margin: -13px 0 0 -13px;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.3s ease;
        transform: translate(var(--cx, -9999px), var(--cy, -9999px));
      }
      body.has-custom-cursor .cyber-crosshair {
        opacity: 1;
      }

      .ch-center {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 4px;
        height: 4px;
        margin: -2px 0 0 -2px;
        background: #ef4444;
        border-radius: 50%;
        box-shadow: 0 0 6px #ef4444;
      }
      .ch-ring {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(59, 130, 246, 0.6);
        border-radius: 50%;
        box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
        animation: crosshair-pulse 2s infinite alternate;
      }

      @keyframes crosshair-pulse {
        0% { transform: scale(0.9); border-color: rgba(239, 68, 68, 0.7); }
        100% { transform: scale(1.1); border-color: rgba(59, 130, 246, 0.8); }
      }

      @media (hover: none), (prefers-reduced-motion: reduce) {
        .cyber-crosshair, .spark-trail-canvas { display: none !important; }
      }
    </style>

    <!-- Cyber Crosshair & Spark Trail JS Engine -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.matchMedia('(hover: none)').matches) return;

        var canvas = document.querySelector('.spark-trail-canvas');
        var crosshair = document.querySelector('.cyber-crosshair');
        if (!canvas || !crosshair) return;

        var ctx = canvas.getContext('2d');
        var width = canvas.width = window.innerWidth;
        var height = canvas.height = window.innerHeight;

        window.addEventListener('resize', function () {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        }, { passive: true });

        var tx = -9999, ty = -9999, cx = -9999, cy = -9999;
        var started = false;
        var sparks = [];
        var colors = ['#ef4444', '#f87171', '#3b82f6', '#60a5fa'];
        var colorIdx = 0;

        function addSpark(x, y) {
          for (var i = 0; i < 2; i++) {
            var angle = Math.random() * Math.PI * 2;
            var speed = Math.random() * 1.8 + 0.4;
            sparks.push({
              x: x,
              y: y,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - 0.5,
              radius: Math.random() * 2.2 + 1.2,
              color: colors[(colorIdx++) % colors.length],
              alpha: 1,
              decay: Math.random() * 0.035 + 0.02
            });
          }
          if (sparks.length > 80) sparks.splice(0, 20);
        }

        window.addEventListener('pointermove', function (e) {
          tx = e.clientX;
          ty = e.clientY;
          if (!started) {
            started = true;
            cx = tx; cy = ty;
            document.body.classList.add('has-custom-cursor');
          }
          addSpark(tx, ty);
        }, { passive: true });

        function render() {
          ctx.clearRect(0, 0, width, height);

          // Smooth lerp for crosshair pointer
          cx += (tx - cx) * 0.35;
          cy += (ty - cy) * 0.35;
          crosshair.style.setProperty('--cx', cx + 'px');
          crosshair.style.setProperty('--cy', cy + 'px');

          // Render & update sparks
          for (var i = sparks.length - 1; i >= 0; i--) {
            var s = sparks[i];
            s.x += s.vx;
            s.y += s.vy;
            s.alpha -= s.decay;

            if (s.alpha <= 0) {
              sparks.splice(i, 1);
              continue;
            }

            ctx.save();
            ctx.globalAlpha = s.alpha;
            ctx.fillStyle = s.color;
            ctx.shadowBlur = 6;
            ctx.shadowColor = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }

          requestAnimationFrame(render);
        }

        requestAnimationFrame(render);
      })();
    </script>

    <!-- Scroll reveal script -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('main .section');
        if (!els.length) return;
        els.forEach(function (el) { el.classList.add('reveal-init'); });
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('reveal-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('reveal-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -7% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
