---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PacmanArcade from '../components/PacmanArcade.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yanosh — Backend & Software Engineer',
  description = 'Personal site of Yanosh (Janos) — software engineer open to work. Specializing in C# (.NET) and Go (Golang) backend development. Based in Kyiv.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Ambient Depth: dual aurora glows, cyber grid pattern -->
    <div class="glow" aria-hidden="true"></div>
    <div class="cyber-grid" aria-hidden="true"></div>

    <!-- Pac-Man & Ghost Retro Arcade Track -->
    <PacmanArcade />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll reveal script -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('main .section');
        if (!els.length) return;
        els.forEach(function (el) { el.classList.add('reveal-init'); });
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('reveal-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('reveal-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -7% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
